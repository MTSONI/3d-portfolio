# ---------------------------------------------------------------------------
# Copy this file to `.env` (optional).
# The site builds, deploys and runs with zero environment variables needed.
# ---------------------------------------------------------------------------

# Optional: Your live domain, no trailing slash. Drives the sitemap, robots.txt,
# canonical URL and Open Graph metadata. Leave it unset locally.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Optional: Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
